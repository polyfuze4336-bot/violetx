# ─────────────────────────────────────────────────────────────
# VioletX — environment variables (copy to .env for local dev)
# Never commit a real .env file. In Azure these come from App
# Settings / Key Vault references, not from this file.
# ─────────────────────────────────────────────────────────────

# Azure SQL Database connection string (Prisma sqlserver provider).
DATABASE_URL="sqlserver://localhost:1433;database=violetx;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"

# Session / cookie signing (Auth.js). openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Owner (Patient X) account — created/updated by the seed. The owner logs in
# with these credentials; the email identifies the single athlete.
OWNER_EMAIL="athlete@example.com"
OWNER_PASSWORD="VioletX-Dev-Pass1"

# Optional coach account seed (read-only). Owner can also configure this in-app.
COACH_EMAIL=""
COACH_PASSWORD=""

# ── AI (Violet) — Azure OpenAI preferred. Leave blank to run without AI; the
#    deterministic WhatsApp parser is used as a fallback. Keys go in Key Vault.
AI_PROVIDER="azure-openai"
AZURE_OPENAI_ENDPOINT=""
AZURE_OPENAI_API_KEY=""
AZURE_OPENAI_DEPLOYMENT=""
AZURE_OPENAI_API_VERSION="2024-10-21"

# ── Maps (Gym Journey) — Azure Maps preferred, behind a provider abstraction.
AZURE_MAPS_KEY=""

# Observability
APPLICATIONINSIGHTS_CONNECTION_STRING=""

# Optional: Azure Key Vault name (secrets resolved at startup via managed identity)
AZURE_KEY_VAULT_NAME=""

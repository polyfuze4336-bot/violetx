# ─────────────────────────────────────────────────────────────
# Progress — environment variables (copy to .env for local dev)
# Never commit a real .env file. In Azure these come from App
# Settings / Key Vault references, not from this file.
# ─────────────────────────────────────────────────────────────

# Azure SQL Database connection string (Prisma sqlserver provider).
# Local dev example (SQL Server / Azure SQL):
# sqlserver://HOST:1433;database=DB;user=USER;password=PASSWORD;encrypt=true;trustServerCertificate=false
DATABASE_URL="sqlserver://localhost:1433;database=progress;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"

# NextAuth
# Generate a secret with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Microsoft Entra ID (Azure AD) OAuth app registration
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# Role mapping — the athlete (OWNER) email address.
# Any authenticated user that is NOT this email is treated as COACH (read-only).
OWNER_EMAIL="athlete@example.com"

# Optional: comma-separated list of allowed coach emails. If set, only these
# emails (plus OWNER_EMAIL) may sign in. Leave empty to allow any Entra user.
ALLOWED_COACH_EMAILS=""

# Optional: Azure Key Vault name. When set (and running with a managed
# identity), secrets are resolved from Key Vault at startup.
AZURE_KEY_VAULT_NAME=""

// Progress — Prisma schema (Azure SQL Database)
//
// Notes:
// - The SQL Server connector does NOT support Prisma enums, so role/unit/type
//   fields are stored as String and validated in the app layer with Zod.
// - Records belong to an Athlete (multi-athlete-capable) but v1 has a single
//   Athlete owned by the OWNER user. The Coach reads the same athlete.
// - Personal records are DERIVED from ExerciseEntry data in the service layer,
//   so they are always consistent (no separate PR table to keep in sync).
// - SQL Server forbids multiple/cyclic cascade paths, so all relations use
//   NoAction referential actions and deletions are handled in the service layer.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Authenticated identity (database credentials). role is "OWNER" or "COACH".
model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String?
  image               String?   @db.NVarChar(1024)
  role                String    @default("COACH") @db.NVarChar(16)
  passwordHash        String?   @db.NVarChar(255)
  active              Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  ownedAthlete      Athlete?             @relation("AthleteOwner")
  importBatches     ImportBatch[]
  approvedAiActions AIAction[]
  resetTokens       PasswordResetToken[]

  @@index([role])
}

/// Password-reset tokens (hashed). Supports the forgot/reset password flow.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique @db.NVarChar(255)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([userId])
}

/// The athlete whose data is tracked. Owned by exactly one OWNER user.
model Athlete {
  id                     String    @id @default(cuid())
  ownerUserId            String    @unique
  displayName            String    @db.NVarChar(200)
  heightCm               Decimal?  @db.Decimal(5, 1)
  birthDate              DateTime?
  sex                    String?   @db.NVarChar(16)
  defaultWeightUnit      String    @default("KG") @db.NVarChar(8)
  defaultMeasurementUnit String    @default("CM") @db.NVarChar(8)
  trustedAiImports       Boolean   @default(false)
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner            User               @relation("AthleteOwner", fields: [ownerUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bodyWeights      BodyWeightEntry[]
  measurementTypes MeasurementType[]
  measurements     MeasurementEntry[]
  exercises        Exercise[]
  sessions         WorkoutSession[]
  exerciseEntries  ExerciseEntry[]
  notes            Note[]
  importBatches    ImportBatch[]
  gymVisits        GymVisit[]
  nutritionEntries NutritionEntry[]
  coachShareLinks  CoachShareLink[]
  workoutPrograms  WorkoutProgram[]
  goals            Goal[]
  checkIns         DailyCheckIn[]
  aiProposals      AIProposalLog[]
}

/// Body weight over time (always kilograms).
model BodyWeightEntry {
  id            String   @id @default(cuid())
  athleteId     String
  date          DateTime
  weightKg      Decimal  @db.Decimal(6, 2)
  note          String?  @db.NVarChar(1024)
  source        String   @default("MANUAL") @db.NVarChar(16)
  importBatchId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  athlete     Athlete      @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, date])
}

/// Owner-managed measurement definitions (e.g. Waist, Hip, Chest).
/// defaultUnit is "CM" or "INCH".
model MeasurementType {
  id          String   @id @default(cuid())
  athleteId   String
  name        String   @db.NVarChar(100)
  defaultUnit String   @default("CM") @db.NVarChar(8)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  athlete Athlete            @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries MeasurementEntry[]

  @@unique([athleteId, name])
}

/// A single body-measurement reading. unit is "CM" or "INCH".
model MeasurementEntry {
  id            String   @id @default(cuid())
  athleteId     String
  typeId        String
  date          DateTime
  value         Decimal  @db.Decimal(6, 2)
  unit          String   @default("CM") @db.NVarChar(8)
  note          String?  @db.NVarChar(1024)
  source        String   @default("MANUAL") @db.NVarChar(16)
  importBatchId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  athlete     Athlete         @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  type        MeasurementType @relation(fields: [typeId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  importBatch ImportBatch?    @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, typeId, date])
}

/// Owner-managed exercise definitions.
model Exercise {
  id               String   @id @default(cuid())
  athleteId        String
  name             String   @db.NVarChar(150)
  category         String?  @db.NVarChar(60)
  muscleGroup      String?  @db.NVarChar(60)
  equipment        String?  @db.NVarChar(60)
  /// Comma-separated alternative names ("OHP, Military Press").
  aliases          String?  @db.NVarChar(400)
  /// Comma-separated secondary muscle groups.
  secondaryMuscles String?  @db.NVarChar(200)
  movementPattern  String?  @db.NVarChar(40)
  instructions     String?  @db.NVarChar(Max)
  tips             String?  @db.NVarChar(1024)
  /// false = shipped with the starter library; true = user-created.
  isCustom         Boolean  @default(true)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  athlete           Athlete                   @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries           ExerciseEntry[]
  workoutExercises  WorkoutExercise[]
  templateExercises WorkoutTemplateExercise[]

  @@unique([athleteId, name])
}

/// A training day / gym visit. Groups exercise entries by date. Sessions
/// created by WhatsApp imports are COMPLETED with no start/end time; sessions
/// logged live through the Active Workout screen start as IN_PROGRESS.
model WorkoutSession {
  id            String    @id @default(cuid())
  athleteId     String
  date          DateTime
  name          String?   @db.NVarChar(120)
  /// IN_PROGRESS | COMPLETED | SKIPPED
  status        String    @default("COMPLETED") @db.NVarChar(16)
  startedAt     DateTime?
  endedAt       DateTime?
  gymBranchId   String?
  programId     String?
  templateId    String?
  /// Overall session RPE (1-10) and perceived difficulty (1-5).
  sessionRpe    Int?
  difficulty    Int?
  note          String?   @db.NVarChar(2048)
  importBatchId String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  athlete     Athlete           @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gymBranch   GymBranch?        @relation(fields: [gymBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entries     ExerciseEntry[]
  exercises   WorkoutExercise[]
  importBatch ImportBatch?      @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  program     WorkoutProgram?   @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  template    WorkoutTemplate?  @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, date])
  @@index([athleteId, status])
}

/// An exercise performed (or planned/skipped) within a live workout, with its
/// order, optional superset grouping and notes. Its sets are ExerciseEntry rows.
model WorkoutExercise {
  id            String   @id @default(cuid())
  athleteId     String
  sessionId     String
  exerciseId    String
  sortOrder     Int      @default(0)
  supersetGroup Int?
  notes         String?  @db.NVarChar(1024)
  skipped       Boolean  @default(false)
  /// Targets copied from the template at start, so editing a program never
  /// rewrites what was planned for past workouts.
  targetSets    Int?
  repMin        Int?
  repMax        Int?
  restSec       Int?
  createdAt     DateTime @default(now())

  session  WorkoutSession  @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sets     ExerciseEntry[]

  @@index([sessionId, sortOrder])
  @@index([athleteId, exerciseId])
}

/// One performed set: reps x weightKg for an exercise on a date.
/// e.g. "Hip abduction 9x50kg" => reps=9, weightKg=50.
model ExerciseEntry {
  id                String    @id @default(cuid())
  athleteId         String
  exerciseId        String
  sessionId         String?
  date              DateTime
  reps              Int
  weightKg          Decimal   @db.Decimal(6, 2)
  sets              Int?
  position          Int       @default(0)
  /// WORK | WARMUP | DROP | FAILURE. Warm-up sets never count towards PRs/volume.
  setType           String    @default("WORK") @db.NVarChar(12)
  rpe               Decimal?  @db.Decimal(3, 1)
  rir               Int?
  completedAt       DateTime?
  workoutExerciseId String?
  note              String?   @db.NVarChar(1024)
  source            String    @default("MANUAL") @db.NVarChar(16)
  importBatchId     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  athlete         Athlete          @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exercise        Exercise         @relation(fields: [exerciseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  session         WorkoutSession?  @relation(fields: [sessionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  workoutExercise WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  importBatch     ImportBatch?     @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, exerciseId, date])
  @@index([athleteId, date])
}

/// Free-text training notes tied to a date.
model Note {
  id        String   @id @default(cuid())
  athleteId String
  date      DateTime
  title     String?  @db.NVarChar(200)
  body      String   @db.NVarChar(Max)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, date])
}

/// Audit + grouping record for a WhatsApp import. Also serves as the AI import
/// session (originalText/detectedDate/status + optional aiProvider/model).
model ImportBatch {
  id          String    @id @default(cuid())
  athleteId   String
  createdById String
  rawText     String    @db.NVarChar(Max)
  sourceDate  DateTime?
  status      String    @default("COMMITTED") @db.NVarChar(20)
  aiProvider  String?   @db.NVarChar(40)
  model       String?   @db.NVarChar(80)
  createdAt   DateTime  @default(now())

  athlete      Athlete            @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy    User               @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  bodyWeights  BodyWeightEntry[]
  measurements MeasurementEntry[]
  sessions     WorkoutSession[]
  exercises    ExerciseEntry[]
  aiActions    AIAction[]

  @@index([athleteId, createdAt])
}

/// A single AI-proposed change (audit trail). payload is validated JSON; the AI
/// never writes to the database directly — proposals are approved then applied.
model AIAction {
  id            String    @id @default(cuid())
  importBatchId String
  actionType    String    @db.NVarChar(60)
  payload       String    @db.NVarChar(Max)
  confidence    Float?
  status        String    @default("PROPOSED") @db.NVarChar(20)
  approvedById  String?
  approvedAt    DateTime?
  createdAt     DateTime  @default(now())

  importBatch ImportBatch @relation(fields: [importBatchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy  User?       @relation(fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([importBatchId])
}

/// An Anytime Fitness Malaysia branch. Totals come from this table — never
/// hardcode branch counts. Sourced from a locally controlled dataset.
model GymBranch {
  id              String    @id @default(cuid())
  name            String    @db.NVarChar(200)
  address         String?   @db.NVarChar(400)
  city            String?   @db.NVarChar(120)
  state           String    @db.NVarChar(80)
  postcode        String?   @db.NVarChar(20)
  latitude        Float
  longitude       Float
  active          Boolean   @default(true)
  source          String?   @db.NVarChar(80)
  sourceUpdatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  visits   GymVisit[]
  sessions WorkoutSession[]

  @@index([state])
  @@index([active])
}

/// A visit by the athlete to a gym branch. Unique exploration counts distinct
/// branches; repeat visits do not increase exploration percentage.
model GymVisit {
  id          String   @id @default(cuid())
  athleteId   String
  gymBranchId String
  visitedAt   DateTime
  notes       String?  @db.NVarChar(1024)
  source      String   @default("MANUAL") @db.NVarChar(16)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  athlete   Athlete   @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  gymBranch GymBranch @relation(fields: [gymBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, gymBranchId])
  @@index([athleteId, visitedAt])
}

/// Optional nutrition log. Nutrition is never required for the app to function.
model NutritionEntry {
  id            String   @id @default(cuid())
  athleteId     String
  entryDate     DateTime
  calories      Int?
  protein       Decimal? @db.Decimal(6, 1)
  carbohydrates Decimal? @db.Decimal(6, 1)
  fat           Decimal? @db.Decimal(6, 1)
  fibre         Decimal? @db.Decimal(6, 1)
  water         Decimal? @db.Decimal(6, 2)
  notes         String?  @db.NVarChar(2048)
  source        String   @default("MANUAL") @db.NVarChar(16)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, entryDate])
}

/// Read-only, revocable, expiring share link that lets a coach view the
/// athlete's progress without signing in. Only a SHA-256 hash of the secret
/// token is stored; the raw token is shown to the owner once at creation.
model CoachShareLink {
  id           String    @id @default(cuid())
  athleteId    String
  tokenHash    String    @unique @db.NVarChar(64)
  label        String?   @db.NVarChar(100)
  expiresAt    DateTime
  revokedAt    DateTime?
  lastViewedAt DateTime?
  createdAt    DateTime  @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId])
}

/// A training program (e.g. Push / Pull / Legs). Archived programs stay in the
/// database so historical workouts keep their program link.
model WorkoutProgram {
  id          String   @id @default(cuid())
  athleteId   String
  name        String   @db.NVarChar(120)
  /// PPL | UPPER_LOWER | FULL_BODY | CUSTOM
  programType String   @default("CUSTOM") @db.NVarChar(16)
  description String?  @db.NVarChar(1024)
  isActive    Boolean  @default(false)
  archived    Boolean  @default(false)
  /// MANUAL | AI (proposal reviewed and confirmed by the athlete)
  source      String   @default("MANUAL") @db.NVarChar(16)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  athlete   Athlete           @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  templates WorkoutTemplate[]
  sessions  WorkoutSession[]

  @@index([athleteId, archived])
}

/// One scheduled day of a program (e.g. "Push A").
model WorkoutTemplate {
  id        String   @id @default(cuid())
  programId String
  athleteId String
  name      String   @db.NVarChar(120)
  dayOrder  Int      @default(0)
  /// Optional preferred weekday, 0 = Sunday .. 6 = Saturday.
  weekday   Int?
  notes     String?  @db.NVarChar(1024)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  program   WorkoutProgram            @relation(fields: [programId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exercises WorkoutTemplateExercise[]
  sessions  WorkoutSession[]

  @@index([programId, dayOrder])
}

model WorkoutTemplateExercise {
  id         String  @id @default(cuid())
  templateId String
  exerciseId String
  sortOrder  Int     @default(0)
  targetSets Int     @default(3)
  repMin     Int     @default(8)
  repMax     Int     @default(12)
  restSec    Int?
  notes      String? @db.NVarChar(512)

  template WorkoutTemplate @relation(fields: [templateId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  exercise Exercise        @relation(fields: [exerciseId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([templateId, sortOrder])
}

/// Audit trail for AI-assisted proposals. The AI never writes fitness data; a
/// proposal only becomes data after the athlete reviews and confirms it.
model AIProposalLog {
  id          String   @id @default(cuid())
  athleteId   String
  kind        String   @db.NVarChar(40)
  /// PROPOSED | APPROVED | REJECTED
  status      String   @default("APPROVED") @db.NVarChar(16)
  provider    String?  @db.NVarChar(40)
  model       String?  @db.NVarChar(80)
  payload     String   @db.NVarChar(Max)
  createdById String
  createdAt   DateTime @default(now())

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, createdAt])
}

/// A fitness goal. Progress is always computed from recorded data; startValue
/// is captured at creation so the trajectory has a fixed reference point.
model Goal {
  id           String    @id @default(cuid())
  athleteId    String
  /// BODY_WEIGHT | WAIST | STRENGTH | WORKOUT_FREQUENCY | CONSISTENCY | CUSTOM
  type         String    @db.NVarChar(24)
  title        String    @db.NVarChar(120)
  exerciseId   String?
  startValue   Decimal?  @db.Decimal(9, 2)
  targetValue  Decimal   @db.Decimal(9, 2)
  /// Manually maintained current value (CUSTOM goals only).
  currentValue Decimal?  @db.Decimal(9, 2)
  /// CONSISTENCY: sessions per week that count as a "consistent" week.
  weeklyTarget Int?
  unit         String    @default("") @db.NVarChar(16)
  startDate    DateTime
  targetDate   DateTime?
  /// ACTIVE | ACHIEVED | ARCHIVED
  status       String    @default("ACTIVE") @db.NVarChar(12)
  notes        String?   @db.NVarChar(1024)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([athleteId, status])
}

/// Optional daily recovery check-in (one per athlete per day). Fitness and
/// recovery guidance only � never medical advice.
model DailyCheckIn {
  id           String   @id @default(cuid())
  athleteId    String
  date         DateTime
  sleepHours   Decimal  @db.Decimal(4, 1)
  sleepQuality Int
  energy       Int
  /// 1 = fresh .. 5 = very sore
  soreness     Int
  /// 1 = calm .. 5 = very stressed
  stress       Int
  motivation   Int
  restingHr    Int?
  notes        String?  @db.NVarChar(1024)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  athlete Athlete @relation(fields: [athleteId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([athleteId, date])
}
